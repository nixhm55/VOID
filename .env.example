# VOID Music Player — Environment Configuration Example
# Copy to .env and fill in optional provider credentials / gateway URLs as needed.
# IMPORTANT: VITE_ variables are exposed to client-side code. Never place private server secrets here.

PORT=3010
BASE_PATH=/

# Provider C: Jamendo Music API (Required for Jamendo track search)
# Register a public client_id at https://devportal.jamendo.com
VITE_JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# Provider E: Third-Party Lossless Gateway (Comma-separated list of authorized lossless gateway base URLs)
# Each endpoint should expose documented /search?q=... and /track?id=... or direct stream URLs
VITE_LOSSLESS_API_URLS=

# Provider F: YouTube Search & Stream Backends (Optional overrides / fallbacks)
# Primary defaults: https://void-backend-beta.vercel.app (search) and https://void-backend-n0jb.onrender.com (stream & fallback search)
VITE_YOUTUBE_API_URL=
VITE_YOUTUBE_FALLBACK_URLS=
